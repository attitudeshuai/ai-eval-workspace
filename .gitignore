# Dependencies
node_modules/
.pnpm-store/
.yarn/cache/

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Secrets & credentials (DO NOT COMMIT real secrets)
# 仅忽略名为 secrets.toml 的文件；secrets-simple.toml / secrets.example.toml 等模板可提交
**/secrets.toml

# IDE
.vscode/
.idea/
*.sw?
*~

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Sessions runtime artifacts (keep structure, ignore heavy artifacts)
sessions/**/submissions/**/source/node_modules/
sessions/**/submissions/**/screenshots/*.png
sessions/**/submissions/**/screenshots/*.jpg
sessions/**/reports/**/evidence/*.png
sessions/**/reports/**/evidence/*.jpg
sessions/**/logs/*.log

# Solo/GSB 工作数据（source code, ai-model-result）不提交
sessions/code-eval-solo/*/source code/
sessions/code-eval-solo/*/ai-model-result/
sessions/code-eval-gsb/*/source code/
sessions/code-eval-gsb/*/ai-model-result/

# Demo 任务例外
!sessions/code-eval-solo/solo-demo/
!sessions/code-eval-gsb/session-gsb1v1/

# Large binary assets in tasks (uncomment if needed)
# tasks/**/*.png
# tasks/**/*.jpg
# tasks/**/*.mp4

# webdev-long-horizon task assets: kept locally, delivered as archives, not tracked in git
projects/webdev-long-horizon/tasks/*
!projects/webdev-long-horizon/tasks/webdev-task-sxw-simple/

projects/webdev-long-horizon/sources/*
!projects/webdev-long-horizon/sources/webdev-task-sxw-simple/

# Secrets
projects/webdev-long-horizon/secrets.toml

# Project config with remote credentials
projects/webdev-long-horizon/config.toml

/sessions/*
!/sessions/code-eval-solo/
!/sessions/code-eval-gsb/
/deliverables/*
!/deliverables/code-eval-solo/
!/deliverables/code-eval-gsb/

# Demo 任务例外
!/sessions/code-eval-solo/solo-demo/
!/sessions/code-eval-solo/solo-demo/source code/
!/sessions/code-eval-solo/solo-demo/ai-model-result/
!/sessions/code-eval-gsb/session-gsb1v1/
!/sessions/code-eval-gsb/session-gsb1v1/source code/
!/sessions/code-eval-gsb/session-gsb1v1/ai-model-result/
!/deliverables/code-eval-solo/solo-demo/
!/deliverables/code-eval-gsb/session-gsb1v1/

*.png
*.xlsx
\projects\pairwise-gsb\extracted_images

# pairwise-gsb demo 例外：仅 demo 目录纳入 git，其余 session 数据仍忽略
!/sessions/pairwise-gsb/
/sessions/pairwise-gsb/*
!/sessions/pairwise-gsb/demo/
!sessions/pairwise-gsb/demo/**/*.xlsx
# 原始数据备份（>100MB）不提交
sessions/pairwise-gsb/demo/**/original.xlsx
!/deliverables/pairwise-gsb/
/deliverables/pairwise-gsb/*
!/deliverables/pairwise-gsb/demo/
!deliverables/pairwise-gsb/demo/**/*.xlsx
# Excel 锁文件任何情况都不提交
~$*

/.tmp